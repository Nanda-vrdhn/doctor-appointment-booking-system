# --- copy to backend/.env, then set real values on the server --------------
# Production settings. The app refuses to start with the default JWT secret.
NODE_ENV=production

# Use 0.0.0.0 so the server is reachable from outside the machine.
# 127.0.0.1 only accepts local connections and will look like a dead deploy.
HOST=0.0.0.0
PORT=5000

# Only needed when the React app is hosted on a DIFFERENT site than the API.
# If this server also serves frontend/dist (the default), leave as-is.
CLIENT_ORIGIN=/

# SQLite file. Give it an absolute path on a persistent disk/volume so
# appointments survive restarts and redeploys.
DB_PATH=/var/lib/doctor-appointment/appointments.db

# Strong random value, e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d
COOKIE_NAME=dat_token
