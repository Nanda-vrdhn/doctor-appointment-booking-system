# --- copy to backend/.env and edit locally (backend/.env is git-ignored) ---
NODE_ENV=development
PORT=5000
HOST=127.0.0.1
CLIENT_ORIGIN=http://localhost:5173

# SQLite database file (relative paths resolve against the backend folder).
# Override with an absolute path if you prefer.
DB_PATH=data/appointments.db

# Long random string. NEVER commit the real value.
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d
COOKIE_NAME=dat_token
